# Passwordless sudo for the commands ./setup.sh invokes, so bmrb-extract.service
# can run it at boot without a TTY. Generated by ./config.sh — do not edit here;
# edit systemd/bmrb-extract.sudoers.template and re-run ./config.sh.
#
# Installed to /etc/sudoers.d/bmrb-extract (0440 root:root) by ./install_systemd.sh.
#
# NOTE: svc.sh lives under the service user's home and is writable by that user,
# so this rule is effectively root-equivalent for ${SERVICE_USER}. That account is
# already in the sudo group, so the marginal exposure is small — but it is real.

Cmnd_Alias BMRBX_RUNNER = ${SERVICE_DIR}/actions-runner/*/svc.sh

Cmnd_Alias BMRBX_SYSCTL = /usr/sbin/sysctl -w net.core.rmem_max=*, \
                          /usr/sbin/sysctl -w net.core.wmem_max=*, \
                          /usr/sbin/sysctl -w vm.overcommit_memory=*

Cmnd_Alias BMRBX_HOST   = /usr/bin/hostnamectl set-hostname *

Cmnd_Alias BMRBX_DIRS   = /usr/bin/mkdir -p /var/lib/*, \
                          /usr/bin/mkdir -p /var/log/*, \
                          /usr/bin/chown ${SERVICE_USER}\:${SERVICE_USER} /var/lib/*, \
                          /usr/bin/chown ${SERVICE_USER}\:${SERVICE_USER} /var/log/*

${SERVICE_USER} ALL=(root) NOPASSWD: BMRBX_RUNNER, BMRBX_SYSCTL, BMRBX_HOST, BMRBX_DIRS
