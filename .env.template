#!/bin/sh

# Standalone NMR data conversion service
export SERVICE_NAME=bmrb_extract
export SERVICE_LEVEL=						# [ "production" or "develop" ]
export SERVICE_SUBDOMAIN=bmrb-extract
export SERVICE_DOMAIN=						# [ "bmrb.io" or "pdbj.org" ]
export SERVICE_HOST=${SERVICE_SUBDOMAIN}.${SERVICE_DOMAIN}
export SERVICE_ADMIN_EMAIL=					# set administrator mail address of your site
export SERVICE_HELP_EMAIL=					# set communication mail address of your site
export SERVICE_ANNOT_EMAILS=					# set list of email addresses for annotators assigned to both sites (must have access to all sessions to handle user inquiries; comma-separated)
export SMTP_SERVER=						# set SMTP server of your site (assuming internal access allows to SMTP access without authentification)
export AUTH_SECRET=						# if a key is not set, config.sh generates a key.

export SUCCESS_VALIDITY_PERIOD_IN_DAYS=420
export FAILURE_VALIDITY_PERIOD_IN_DAYS=60

# Nginx with OpenSSL (both are configured from source code using the latest version)
NGINX_VERSION=`curl -I -L -s -o /dev/null -w '%{url_effective}\n' https://github.com/nginx/nginx/releases/latest | cut -d '-' -f2`
NGINX_LOG_FORMAT=						# [ "default" or "json" ] See also nginx/nginx.conf
NGINX_LOG_VOL_LABEL=nginx_logs
NGINX_LOG_VOL_DIR=/var/log/nginx_logs

# PostgreSQL
export POSTGRES_HOST=postgres
export POSTGRES_USER=$USER
export POSTGRES_PASSWORD=

# database for service operation
export POSTGRES_SERVICE_DB=internal
# dababase for workflow engine
export POSTGRES_PREFECT_DB=prefect

# Defaults below are overridden per service level by config.sh
# (pg_data_<level> / /var/lib/pg_data_<level>) so production and
# development never share a data store.
POSTGRES_DATA_VOL_LABEL=pg_data
POSTGRES_DATA_VOL_DIR=/var/lib/pg_data

# Archive storage (uploaded files, one git repo per session)
export ARCHIVE_BASE_PATH=/archive
ARCHIVE_VOL_DIR=/var/lib/${ARCHIVE_BASE_PATH}

# Conversion workspace (per conversion_id/run_number; input copies, output,
# intermediate scratch, logs) — kept separate from the git-managed archive.
export WORKSPACE_BASE_PATH=/workspace
WORKSPACE_VOL_DIR=/var/lib/${WORKSPACE_BASE_PATH}

# Cross-site data exchange (peer production server). Every 6 hours the
# exchange-sessions flow pulls the PEER site's valid sessions (DB rows + archive
# + workspace) over SSH/rsync and merges them into the local DB for
# troubleshooting. Disabled until PEER_HOST is set (config.sh writes PEER_HOST /
# PEER_DOMAIN). The peer SSH key + known_hosts live under ./secrets (gitignored),
# mounted into the prefect-worker at /secrets. PEER_PSQL is the command the peer
# SSH account runs to read its own 'internal' DB (SQL piped on stdin).
export PEER_SSH_USER=bmrbxchg
export PEER_SSH_PORT=22
export PEER_SSH_KEY=/secrets/peer_ssh_key
export PEER_KNOWN_HOSTS=/secrets/peer_known_hosts
export PEER_PSQL="psql -d internal"
export PEER_ARCHIVE_DIR=/var/lib/archive
export PEER_WORKSPACE_DIR=/var/lib/workspace

# Workflow engine (Prefect)
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_MESSAGING_BROKER=prefect_redis.messaging
PREFECT_MESSAGING_CACHE=prefect_redis.messaging
PREFECT_REDIS_MESSAGING_HOST=redis
PREFECT_REDIS_MESSAGING_PORT=6379
PREFECT_REDIS_MESSAGING_DB=0
PREFECT_LOGGING_LEVEL=INFO
PREFECT_SERVER_UI_API_URL=http://prefect-server:4200/api
export PREFECT_API_URL=${PREFECT_SERVER_UI_API_URL}

# GitHub Container Repository
REPO_OWNER=yokochi47
MAXIT_CCD_REPO=maxit-ccd
UTILS_NMR_REPO=py-wwpdb_utils_nmr
export MAXIT_CCD_IMAGE=ghcr.io/${REPO_OWNER}/${MAXIT_CCD_REPO}:main
export UTILS_NMR_IMAGE=ghcr.io/${REPO_OWNER}/${UTILS_NMR_REPO}:main

ACTION_RUNNER_DIR=actions-runner
ACTION_RUNNER_VER=2.336.0
ACTION_RUNNER_TARBALL=actions-runner-linux-x64-${ACTION_RUNNER_VER}.tar.gz
ACTION_RUNNER_CHECK_SUM=04cf0be1aff4c3ec3554466c39124ca250e3effd8873bb7e8d68535aa9505d5d
ACTION_RUNNER_BASE_REPO=https://github.com/${REPO_OWNER}
ACTION_RUNNER_REPOS=(${MAXIT_CCD_REPO} ${UTILS_NMR_REPO})
MAXIT_CCD_SELF_RUNNER_TOKEN=					# ask the repo owner for the token
UTILS_NMR_SELF_RUNNER_TOKEN=					# ask the repo owner for the token

