#!/bin/sh

# Standalone NMR data conversion service
SERVICE_NAME=bmrb_extract
SERVICE_LEVEL=							# [ "production" or "develop" ]
SERVICE_SUBDOMAIN=bmrb-extract
SERVICE_DOMAIN=							# [ "bmrb.io" or "pdbj.org" ]
SERVICE_HOST=${SERVICE_SUBDOMAIN}.${SERVICE_DOMAIN}
SERVICE_ADMIN_EMAIL=						# [ set administrator mail address of your site ]
SERVICE_HELP_EMAIL=						# [ set communication mail address of your site ]

SUCCESS_VALIDITY_PERIOD_IN_DAYS=420
FAILURE_VALIDITY_PERIOD_IN_DAYS=60

# Nginx
OPENSSL_VERSION=`curl -I -L -s -o /dev/null -w '%{url_effective}\n' https://github.com/openssl/openssl/releases/latest | cut -d '-' -f2`
NGINX_VERSION=`curl -I -L -s -o /dev/null -w '%{url_effective}\n' https://github.com/nginx/nginx/releases/latest | cut -d '-' -f2`
NGINX_LOG_FORMAT=						# [ "default" or "json" ] See also nginx/nginx.conf
NGINX_LOG_VOL_LABEL=nginx_logs
NGINX_LOG_VOL_DIR=/var/log/nginx_logs

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_USER=$USER                                             # change me
POSTGRES_PASSWORD=						# change me

POSTGRES_SERVICE_DB=internal					# database for service management
POSTGRES_PREFECT_DB=prefect					# dababase for Prefect server

POSTGRES_DATA_VOL_LABEL=pg_data
POSTGRES_DATA_VOL_DIR=/var/lib/pg_data

# Prefect
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_MESSAGING_BROKER=prefect_redis.messaging
PREFECT_MESSAGING_CACHE=prefect_redis.messaging
PREFECT_REDIS_MESSAGING_HOST=redis
PREFECT_REDIS_MESSAGING_PORT=6379
PREFECT_REDIS_MESSAGING_DB=0
PREFECT_LOGGING_LEVEL=INFO
PREFECT_SERVER_UI_API_URL=http://prefect-server:4200/api
PREFECT_API_URL=http://prefect-server:4200/api

# GitHub Container Repository
REPO_OWNER=yokochi47
MAXIT_CCD_REPO=maxit-ccd
UTILS_NMR_REPO=py-wwpdb_utils_nmr
MAXIT_CCD_CONTAINER_REPO=ghcr.io/${REPO_OWNER}/${MAXIT_CCD_REPO}:main
UTILS_NMR_CONTAINER_REPO=ghcr.io/${REPO_OWNER}/${UTILS_NMR_REPO}:main

ACTION_RUNNER_DIR=actions-runner
ACTION_RUNNER_VER=2.330.0
ACTION_RUNNER_TARBALL=actions-runner-linux-x64-${ACTION_RUNNER_VER}.tar.gz
ACTION_RUNNER_CHECK_SUM=af5c33fa94f3cc33b8e97937939136a6b04197e6dadfcfb3b6e33ae1bf41e79a
ACTION_RUNNER_BASE_REPO=https://github.com/${REPO_OWNER}
ACTION_RUNNER_REPOS=(${MAXIT_CCD_REPO} ${UTILS_NMR_REPO})
MAXIT_CCD_SELF_RUNNER_TOKEN=					# ask token from the repo owner
UTILS_NMR_SELF_RUNNER_TOKEN=					# ask token from the repo owner

