# Site specific configurations

SERVICE_LEVEL = '${SERVICE_LEVEL}'

assert SERVICE_LEVEL in ('production', 'development')

SERVICE_DOMAIN = '${SERVICE_DOMAIN}'
SERVICE_HOST = '${SERVICE_HOST}'

SERVICE_ADMIN_EMAIL = '${SERVICE_ADMIN_EMAIL}'
SERVICE_HELP_EMAIL = '${SERVICE_HELP_EMAIL}'

# Auth: high-entropy secret for signing login sessions / magic-link tokens and
# encrypting the TOTP secret at rest. Generated by config.sh; the rendered
# site_config.py is gitignored — never commit it.
AUTH_SECRET = '${AUTH_SECRET}'
# Comma-separated annotator emails (admin allowlist). A member who logs in (email
# magic link + mandatory TOTP) gets the 'annotator' role, which can access every
# session; everyone else is a normal 'user' limited to their own sessions.
SERVICE_ANNOT_EMAILS = '${SERVICE_ANNOT_EMAILS}'

SMTP_SERVER = '${SMTP_SERVER}'
CONV_ID_RANGE_BEGIN = ${CONV_ID_RANGE_BEGIN}
CONV_ID_RANGE_END = ${CONV_ID_RANGE_END}

assert 1000000 <= CONV_ID_RANGE_BEGIN < CONV_ID_RANGE_END <= 9000000
assert CONV_ID_RANGE_END - CONV_ID_RANGE_BEGIN in (99999, 999999)

SERVICE_DATABASE_URL = '${SERVICE_DATABASE_URL}'
FLASK_API_URL = '${FLASK_API_URL}'

SUCCESS_VALIDITY_PERIOD_IN_DAYS = ${SUCCESS_VALIDITY_PERIOD_IN_DAYS}
FAILURE_VALIDITY_PERIOD_IN_DAYS = ${FAILURE_VALIDITY_PERIOD_IN_DAYS}

# Mounted host directories in the container
ARCHIVE_BASE_PATH = '${ARCHIVE_BASE_PATH}'
WORKSPACE_BASE_PATH = '${WORKSPACE_BASE_PATH}'

# BMRB FTP entry directory base. The assigned chemical shifts for a valid
# related BMRB ID (onedep conventional mode) are downloaded from
# {BMRB_ENTRY_DIR_URL}/bmr{ID}/bmr{ID}_3.str. Both production sites fetch from
# bmrb.io; point this at a mirror if needed.
BMRB_ENTRY_DIR_URL = 'https://bmrb.io/ftp/pub/bmrb/entry_directories'

# maxit-ccd coordinate conversion. The prefect coordinate_conversion task runs
# this image via `docker run` with a memory limit (malformed PDB input leaks
# memory); on OOM / no output the convert_model workflow row is marked failed.
MAXIT_CCD_IMAGE = '${MAXIT_CCD_IMAGE}'
MAXIT_MEMORY_LIMIT = '16g'

# py-wwpdb_utils_nmr NMR data conversion (NmrDpUtility). The nmr_data_conversion
# task runs this image via `docker run python <driver>` to validate and convert
# the NMR data to NMR-STAR against the model mmCIF.
UTILS_NMR_IMAGE = '${UTILS_NMR_IMAGE}'

# JSON -> PDF conversion report. Built locally from ./pdf (Python+WeasyPrint +
# Node/ECharts); the deferred convert_pdf task runs it via `docker run` to render
# C_<id>_report.pdf from the last NMR data-processing JSON report.
PDF_REPORT_IMAGE = 'bmrb-extract-pdf-report:local'

