#
# bmrb-extract — local deployment configuration.
#
#   cp .env.local.template .env
#   $EDITOR .env
#   docker compose up -d --build
#
# EVERY value here is read at container start, so changing one and running
# `docker compose up -d` is enough to apply it. Nothing is baked into an image
# at build time and nothing is rendered on the host.
#
# The one exception is the database SCHEMA: PostgreSQL runs the init SQL only
# when its data directory is empty, so SERVICE_DOMAIN and the POSTGRES_*_DB
# names take effect on first start only. Changing them later means starting
# from an empty ${BMRBX_DATA_DIR}/postgres.
#
# Lines are `KEY=value` — no shell expressions, no command substitution. Values
# containing spaces must be quoted.
#

# Compose project name — prefixes container names and the internal network.
COMPOSE_PROJECT_NAME=bmrb-extract

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Everything persistent lives under this directory: PostgreSQL, Redis, the
# Prefect server DB/cache, the upload archive and the conversion workspace.
#
# MUST BE AN ABSOLUTE PATH. The Prefect worker passes the archive/workspace
# paths straight to `docker run -v` against the host daemon, which rejects
# relative paths. ${PWD} resolves to the directory you run `docker compose`
# from — replace it with a literal path if you invoke compose from elsewhere.
BMRBX_DATA_DIR=${PWD}/data

# Host directories bind-mounted into the containers. Created on first start.
POSTGRES_DATA_VOL_DIR=${BMRBX_DATA_DIR}/postgres
REDIS_DATA_VOL_DIR=${BMRBX_DATA_DIR}/redis
ARCHIVE_VOL_DIR=${BMRBX_DATA_DIR}/archive
WORKSPACE_VOL_DIR=${BMRBX_DATA_DIR}/workspace

# The Prefect server's own config/cache directory is NOT here: it lives in a
# named Docker volume on local disk. It is server scratch, not your data — the
# real workflow state is in PostgreSQL — and keeping it off a shared filesystem
# lets that container go on running as root, which is one less thing to go
# wrong. Nothing you care about is lost if the volume is deleted.

# ---------------------------------------------------------------------------
# Container user
# ---------------------------------------------------------------------------
# The containers that write to the directories above run as this uid:gid, so
# the files they create belong to you.
#
# This matters on NFS. A server exporting with the default `root_squash` maps a
# client's root to `nobody`, so a container running as root cannot create or
# write anything inside a directory you own — Docker cannot even create the bind
# mount source. Running as yourself sidesteps all of it.
#
#   HOST_UID=$(id -u)   HOST_GID=$(id -g)
#
# Changing these needs a rebuild (`docker compose up -d --build`): the images
# create a matching account so tools that look up their own user — initdb, most
# obviously — can resolve it.
HOST_UID=1000
HOST_GID=1000

# Group that owns /var/run/docker.sock, so the non-root Prefect worker can still
# launch the conversion containers:
#
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Paths those two trees are mounted at INSIDE every container. The conversion
# images see the same paths, so leave these alone unless you know why.
ARCHIVE_BASE_PATH=/archive
WORKSPACE_BASE_PATH=/workspace

# ---------------------------------------------------------------------------
# Service identity
# ---------------------------------------------------------------------------
SERVICE_NAME=bmrb_extract

# "production" or "development". Affects the on-screen development banner and
# the default for AUTH_COOKIE_SECURE (below). For a plain-HTTP local instance
# keep this at "development" — see AUTH_COOKIE_SECURE.
SERVICE_LEVEL=development

# Hostname this instance answers on. Used for nginx server_name, log lines,
# git commit authorship and the provenance recorded in conversion output.
SERVICE_HOST=localhost

# Base URL handed to users in emails (magic-link login, "send me this URL").
# Must be reachable from wherever people open their mail. Include the scheme
# and the port if it is not the default one.
SERVICE_BASE_URL=http://localhost:8080

# Site flavour. Selects the branding defaults below and — on FIRST START ONLY —
# the value stored in session.processing_site. "bmrb.io" and "pdbj.org" are the
# upstream sites; any other value is added to the database enum automatically.
SERVICE_DOMAIN=bmrb.io

# Addresses. SERVICE_ANNOT_EMAILS is the comma-separated admin allowlist: those
# accounts get the 'annotator' role (access to every session) after logging in
# with a magic link AND a TOTP second factor.
SERVICE_ADMIN_EMAIL=admin@example.org
SERVICE_HELP_EMAIL=help@example.org
SERVICE_ANNOT_EMAILS=admin@example.org

# Signs login sessions and magic-link tokens, and encrypts TOTP secrets at rest.
# GENERATE YOUR OWN:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it invalidates every live login session.
AUTH_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_48

# Timezone for the container clocks and the nightly cleanup / exchange crons.
TZ=US/Eastern

# Retention (Terms & Conditions #8): how long a session stays resumable.
SUCCESS_VALIDITY_PERIOD_IN_DAYS=420
FAILURE_VALIDITY_PERIOD_IN_DAYS=60

# Public conversion-ID range, displayed as C_<id>. Upstream reserves
# 1000001-2000000 for bmrb.io and 2000001-3000000 for pdbj.org; 8000001-9000000
# is the development space. The span must be exactly 99999 or 999999.
CONV_ID_RANGE_BEGIN=8900001
CONV_ID_RANGE_END=9000000

# ---------------------------------------------------------------------------
# Frontend branding — substituted into the built Angular bundle at start
# ---------------------------------------------------------------------------
HOST_SITE_NAME=BMRB
# Served from frontend/public/ — bmrb_logo.png or bmrbj_logo.png ship with it.
HOST_SITE_LOGO=bmrb_logo.png
HOST_SITE_URL=https://bmrb.io
HOST_SITE_FAVICON=favicon.bmrb.ico
PAGE_TITLE=bmrb_extract
ONEDEP_URL=https://deposit.wwpdb.org
BMRBDEP_URL=https://deposit.bmrb.io

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Host port nginx is published on. TLS is not terminated here — put your own
# reverse proxy in front if you want HTTPS.
HTTP_PORT=8080
# Bind address for that port. 127.0.0.1 keeps it on this machine only.
HTTP_BIND=0.0.0.0

# Largest upload nginx accepts.
NGINX_CLIENT_MAX_BODY_SIZE=300m
# Access-log format: "default" (combined) or "json". Logs go to the container's
# stdout/stderr — read them with `docker compose logs nginx`.
NGINX_LOG_FORMAT=default
# How long nginx waits on the backend. Conversions are triggered asynchronously,
# but the analysis endpoints can be slow on large reports.
NGINX_PROXY_READ_TIMEOUT=600s

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# MAIL_BACKEND=smtp   deliver through the server below.
# MAIL_BACKEND=log    do not send anything; write the full message (including
#                     magic-link URLs) to the backend/worker log instead. Useful
#                     for a local instance with no relay — get your login link
#                     with `docker compose logs -f backend`.
MAIL_BACKEND=smtp

SMTP_SERVER=smtp.example.org
SMTP_PORT=25
# Leave SMTP_USER empty for an unauthenticated relay.
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS on a plaintext port (587); SSL wraps the whole connection (465).
SMTP_STARTTLS=false
SMTP_SSL=false
# Envelope/From address. Defaults to SERVICE_ADMIN_EMAIL when empty.
SMTP_FROM=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Marks the login cookie Secure, so browsers only send it over HTTPS. MUST be
# false for a plain-HTTP instance or nobody can stay logged in. Defaults to
# (SERVICE_LEVEL == production) when left empty.
AUTH_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_USER=bmrb_extract
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_SERVICE_DB=internal
POSTGRES_PREFECT_DB=prefect
# PostgreSQL is NOT published on a host port. The containers reach it as
# postgres:5432 over the stack's private network, and publishing it would only
# risk colliding with another PostgreSQL on this machine. To get a prompt:
#   docker compose exec postgres psql -U bmrb_extract -d internal

# Assembled from the values above; the backend and the flows read this.
SERVICE_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_SERVICE_DB}

# ---------------------------------------------------------------------------
# Backend (Flask / Gunicorn)
# ---------------------------------------------------------------------------
FLASK_ENV=production
FLASK_API_URL=http://backend:8000/api/
# Passed straight to Gunicorn. --workers 4 suits a handful of concurrent users;
# --timeout is generous because the analysis endpoints parse large reports.
GUNICORN_CMD_ARGS=--workers 4 --timeout 300

# Redis database used for the auth rate limiter (Prefect uses db 0).
AUTH_REDIS_HOST=redis
AUTH_REDIS_PORT=6379
AUTH_REDIS_DB=1

# ---------------------------------------------------------------------------
# Prefect
# ---------------------------------------------------------------------------
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_MESSAGING_BROKER=prefect_redis.messaging
PREFECT_MESSAGING_CACHE=prefect_redis.messaging
PREFECT_REDIS_MESSAGING_HOST=redis
PREFECT_REDIS_MESSAGING_PORT=6379
PREFECT_REDIS_MESSAGING_DB=0
PREFECT_LOGGING_LEVEL=INFO
PREFECT_SERVER_UI_API_URL=http://prefect-server:4200/api
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_PREFECT_DB}
# Address the Prefect UI is published on. A high port on loopback by default so
# it cannot collide with anything already using 4200; change the port freely.
# Host ports are the only resource this stack shares with the rest of the
# machine — everything else lives on its own private Docker network.
PREFECT_PUBLISH=127.0.0.1:14200

# ---------------------------------------------------------------------------
# Conversion images
# ---------------------------------------------------------------------------
# Pulled from GHCR on first use by the `docker run` calls in the flows.
MAXIT_CCD_IMAGE=ghcr.io/yokochi47/maxit-ccd:main
UTILS_NMR_IMAGE=ghcr.io/yokochi47/py-wwpdb_utils_nmr:main
# Built locally by the `pdf-report` compose service.
PDF_REPORT_IMAGE=bmrb-extract-pdf-report:local

# Hard memory cap for maxit. Malformed PDB input leaks memory, so the container
# is killed rather than allowed to eat the host. Lower it on a small machine.
MAXIT_MEMORY_LIMIT=16g

# Where assigned chemical shifts for a related BMRB ID are fetched from.
BMRB_ENTRY_DIR_URL=https://bmrb.io/ftp/pub/bmrb/entry_directories

# ---------------------------------------------------------------------------
# Cross-site data exchange — leave PEER_HOST empty to keep it disabled
# ---------------------------------------------------------------------------
PEER_HOST=
PEER_DOMAIN=
PEER_SSH_USER=bmrbxchg
PEER_SSH_PORT=22
PEER_SSH_KEY=/secrets/peer_ssh_key
PEER_KNOWN_HOSTS=/secrets/peer_known_hosts
PEER_PSQL=psql -d internal
PEER_ARCHIVE_DIR=/var/lib/archive
PEER_WORKSPACE_DIR=/var/lib/workspace
